<Window x:Class="VolirizeMP.Launcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="VolirizeMP Launcher" Width="1440" Height="900" MinWidth="1080" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#090B12" Foreground="#F5F6FA">
 <Window.Resources><Style x:Key="NavButton" TargetType="Button"><Setter Property="Height" Value="54"/><Setter Property="Margin" Value="0,5"/><Setter Property="Padding" Value="18,0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Foreground" Value="#AEB4C5"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="13"><ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#202638"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#303956"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#10131D" BorderBrush="#252A39" BorderThickness="0,0,1,0"><DockPanel Margin="22,26">
   <StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" Margin="4,4,0,54"><Border Width="44" Height="44" CornerRadius="14" Background="#7567F8"><TextBlock Text="V" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center" Margin="13,0,0,0"><TextBlock Text="VOLIRIZEMP" FontSize="17" FontWeight="Bold" Foreground="White"/><TextBlock Text="MULTIPLAYER" FontSize="9" FontWeight="Bold" Foreground="#858DA2" Margin="0,3,0,0"/></StackPanel></StackPanel>
    <TextBlock Text="MENU" Foreground="#737B91" FontSize="10" FontWeight="Bold" Margin="12,0,0,12"/>
    <Button x:Name="HomeButton" Content="⌂   Home" Style="{StaticResource NavButton}" Click="Home_Click"/><Button x:Name="NewsButton" Content="▤   News" Style="{StaticResource NavButton}" Click="News_Click"/><Button x:Name="DownloadsButton" Content="⇩   Downloads" Style="{StaticResource NavButton}" Click="Downloads_Click"/><Button x:Name="AccountButton" Content="◉   Account" Style="{StaticResource NavButton}" Click="Account_Click"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom" Margin="4,0,4,8"><Border Background="#191E2B" CornerRadius="14" Padding="16" Margin="0,0,0,18"><StackPanel><TextBlock Text="SERVICE STATUS" Foreground="#81899E" FontSize="9" FontWeight="Bold"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#E5A84B" VerticalAlignment="Center"/><TextBlock x:Name="StatusText" Text="Checking..." Foreground="#DDE0EA" FontSize="12" Margin="9,0,0,0"/></StackPanel></StackPanel></Border><TextBlock Text="VOLIRIZEMP  •  v1.0.0" Foreground="#697187" FontSize="10" Margin="8,0,0,0"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="34,28,34,30"><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Grid.Row="0" Margin="4,0,4,18"><TextBlock x:Name="PageTitle" Text="Home" FontSize="25" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock x:Name="SignedInText" Text="Not signed in" Foreground="#929AAF" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid><ContentControl x:Name="PageHost" Grid.Row="1"/></Grid>
 </Grid>
</Window>