<Window x:Class="VolirizeMP.Launcher.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:VolirizeMP.Launcher.Controls;assembly=VolirizeMP Launcher"
 Title="VolirizeMP Launcher" Width="1500" Height="940" MinWidth="1120" MinHeight="720"
 WindowStartupLocation="CenterScreen" Background="#080A10" Foreground="#F5F6FA">
 <Window.Resources>
  <Style x:Key="NavButton" TargetType="Button">
   <Setter Property="Height" Value="52"/><Setter Property="Margin" Value="0,5"/>
   <Setter Property="Padding" Value="18,0"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="Foreground" Value="#B8BDCA"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="13">
     <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#263047"/><Setter Property="Foreground" Value="White"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#394667"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <controls:BackgroundLayer x:Name="BackgroundLayer"/>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#E90B0E16" BorderBrush="#55343B50" BorderThickness="0,0,1,0">
    <DockPanel Margin="22,26">
     <StackPanel DockPanel.Dock="Top">
      <StackPanel Orientation="Horizontal" Margin="4,4,0,48">
       <Border Width="46" Height="46" CornerRadius="15" Background="#7567F8"><TextBlock Text="V" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel VerticalAlignment="Center" Margin="13,0,0,0"><TextBlock Text="VOLIRIZEMP" FontSize="17" FontWeight="Bold" Foreground="White"/><TextBlock Text="MULTIPLAYER" FontSize="9" FontWeight="Bold" Foreground="#9299AD" Margin="0,3,0,0"/></StackPanel>
      </StackPanel>
      <TextBlock Text="WORKSPACE" Foreground="#7F879C" FontSize="10" FontWeight="Bold" Margin="12,0,0,12"/>
      <Button x:Name="HomeButton" Content="⌂   Home" Style="{StaticResource NavButton}" Click="Home_Click"/>
      <Button x:Name="NewsButton" Content="▤   News" Style="{StaticResource NavButton}" Click="News_Click"/>
      <Button x:Name="DownloadsButton" Content="⇩   Downloads" Style="{StaticResource NavButton}" Click="Downloads_Click"/>
      <Button x:Name="AccountButton" Content="◉   Account" Style="{StaticResource NavButton}" Click="Account_Click"/>
     </StackPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="4,0,4,8">
      <Button Content="⚙   Settings" Style="{StaticResource NavButton}" Click="Settings_Click"/>
      <Border Background="#B7191E2B" CornerRadius="14" Padding="15" Margin="0,14,0,17">
       <StackPanel><TextBlock Text="SERVICE STATUS" Foreground="#929AAF" FontSize="9" FontWeight="Bold"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#E5A84B" VerticalAlignment="Center"/><TextBlock x:Name="StatusText" Text="Checking..." Foreground="#E4E7EF" FontSize="12" Margin="9,0,0,0"/></StackPanel>
       </StackPanel>
      </Border>
      <TextBlock Text="VOLIRIZEMP  •  v1.0.0" Foreground="#737B90" FontSize="10" Margin="8,0,0,0"/>
     </StackPanel>
    </DockPanel>
   </Border>
   <Grid Grid.Column="1" Margin="34,28,34,30">
    <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="4,0,4,18"><TextBlock x:Name="PageTitle" Text="Home" FontSize="27" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock x:Name="SignedInText" Text="Not signed in" Foreground="#B6BDCE" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
    <ContentControl x:Name="PageHost" Grid.Row="1"/>
   </Grid>
  </Grid>
 </Grid>
</Window>