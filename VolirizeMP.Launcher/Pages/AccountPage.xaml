<UserControl x:Class="VolirizeMP.Launcher.Pages.AccountPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="12"><StackPanel><TextBlock Text="PLAYER PROFILE" Foreground="#A7AEC2" FontSize="11" FontWeight="Bold"/><TextBlock Text="Account" FontSize="29" FontWeight="Bold" Margin="0,5,0,20"/>
  <Border Background="#C0181E2D" BorderBrush="#55434B63" BorderThickness="1" CornerRadius="18" Padding="26">
   <StackPanel><Border Width="64" Height="64" CornerRadius="32" Background="#7567F8" HorizontalAlignment="Left"><TextBlock Text="V" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="AccountName" Text="Guest" FontSize="22" FontWeight="Bold" Margin="0,16,0,5"/><TextBlock x:Name="AccountStatus" Text="You are not signed in." Foreground="#B7BDCC"/><Button x:Name="SignOutButton" Content="Sign out" Click="SignOut_Click" HorizontalAlignment="Left" Margin="0,22,0,0" Padding="20,11" Background="#30384D" Foreground="White" BorderThickness="0"/></StackPanel>
  </Border><TextBlock Text="Discord sign-in can be connected when your OAuth backend is ready." Foreground="#929AAF" TextWrapping="Wrap" Margin="3,16,0,0"/>
 </StackPanel></Grid>
</UserControl>