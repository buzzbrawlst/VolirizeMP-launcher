<UserControl x:Class="VolirizeMP.Launcher.Pages.NewsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="WHAT'S HAPPENING" Foreground="#A7AEC2" FontSize="11" FontWeight="Bold"/><TextBlock Text="Latest news" FontSize="29" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock x:Name="StatusText" Text="Loading updates..." Foreground="#B7BDCC" Margin="0,7,0,0"/></StackPanel>
  <ScrollViewer Grid.Row="1"><ItemsControl x:Name="NewsList"><ItemsControl.ItemTemplate><DataTemplate>
   <Border Background="#C0181E2D" BorderBrush="#55434B63" BorderThickness="1" CornerRadius="17" Padding="22" Margin="0,0,0,13">
    <StackPanel><TextBlock Text="{Binding Category}" Foreground="#A99FFF" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Margin="0,8,0,5"/><TextBlock Text="{Binding Description}" Foreground="#C1C6D3" TextWrapping="Wrap"/><TextBlock Text="{Binding Date}" Foreground="#929AAF" FontSize="11" Margin="0,12,0,0"/></StackPanel>
   </Border>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
 </Grid>
</UserControl>